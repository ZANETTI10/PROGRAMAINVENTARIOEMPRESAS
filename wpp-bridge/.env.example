# Copia este archivo a ".env" y completa los valores antes de correr el puente.

# URL del webhook de n8n que va a recibir cada mensaje que llegue al WhatsApp
# de la empresa (crea un nodo "Webhook" en n8n y pega aqui su URL). Si lo
# dejas vacio, el puente igual funciona pero no le avisa nada a n8n -- solo
# queda conectado y puede usarse para enviar mensajes desde /enviar.
N8N_WEBHOOK_URL=

# Clave secreta inventada por ti (cualquier texto largo y dificil de
# adivinar). n8n tiene que mandar este mismo valor en el header
# "x-api-key" cuando le pida al puente que envie un mensaje por el
# endpoint /enviar -- sin esto, cualquiera que encuentre la URL del
# puente podria mandar mensajes desde el WhatsApp de la empresa.
BRIDGE_API_KEY=cambia-esto-por-algo-largo-y-secreto

# Puerto donde el puente escucha las peticiones de n8n (POST /enviar,
# GET /estado). 3005 es solo un ejemplo, puedes dejarlo o cambiarlo.
PORT=3005
